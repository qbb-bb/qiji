    <property name="styleSheet">
      <string notr="true">QMainWindow,QWidget{background:#171c26;color:#e8edf7;}
QPushButton{min-height:38px;padding:0 16px;background:#2867d6;color:white;border:0;border-radius:7px;font-weight:600;}
QPushButton:hover{background:#3678e6;} QPushButton:disabled{background:#303746;color:#747f94;}
QComboBox,QSpinBox,QDoubleSpinBox{min-height:34px;background:#0e131b;border:1px solid #354054;border-radius:6px;padding:0 8px;}
QListWidget,QTextEdit{background:#0e131b;border:1px solid #2c3545;border-radius:8px;padding:6px;}
QLabel#homeTitle,QLabel#calibrationTitle{font-size:25px;font-weight:700;}
danmucamera--ImageLabel{color:#8c98ad;background:#0e131b;border:1px solid #2c3545;border-radius:8px;}
QPushButton#refresh_button,QPushButton#disconnect_button,QPushButton#home_retake_button,QPushButton#retake_button,QPushButton#delete_button,QPushButton#back_button{background:#354258;color:#e0e9f7;}
QPushButton#refresh_button:hover,QPushButton#disconnect_button:hover,QPushButton#home_retake_button:hover,QPushButton#retake_button:hover,QPushButton#delete_button:hover,QPushButton#back_button:hover{background:#44536e;}
QPushButton#enter_calibration_button,QPushButton#run_button{background:#168b70;}
QPushButton#guided_button{background:#167d55;}
QPushButton#enter_calibration_button:hover,QPushButton#run_button:hover{background:#20a887;}
QPushButton#guided_button:hover{background:#21a46e;}
QPushButton:disabled{background:#303746;color:#747f94;}
QComboBox#calibration_type_combo{min-width:175px;}
</string>
